# ---- Copy this file to `.env` and fill in what you have. ----
# The pipeline degrades gracefully: with only ANTHROPIC_API_KEY you get all the
# text outputs (edited sermon, summary, captions, podcast script). Add a voice
# key to also render the two-host podcast MP3.

# REQUIRED — the rewrite/summarise/scriptwriting brain.
ANTHROPIC_API_KEY=

# OPTIONAL — only needed if a YouTube video has NO captions and we must
# transcribe the audio ourselves. Whisper via OpenAI.
OPENAI_API_KEY=

# OPTIONAL — render the podcast MP3 with two expressive voices (ElevenLabs v3).
ELEVENLABS_API_KEY=

# ---- Tunables (sensible defaults; override only if you want to) ----

# Anthropic model. claude-opus-5 = best quality. claude-sonnet-5 = cheaper/faster.
SERMON_MODEL=claude-opus-5

# Two ElevenLabs voice IDs for the podcast hosts (find them in your ElevenLabs
# voice library). Leave blank to skip audio even when the key is set.
ELEVENLABS_VOICE_A=
ELEVENLABS_VOICE_B=

# Target length of the podcast, in minutes (a hint to the scriptwriter).
PODCAST_MINUTES=6
